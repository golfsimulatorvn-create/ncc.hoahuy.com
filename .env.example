# Cong NCC (ncc.hoahuy.com) - mau bien moi truong. Sao chep thanh .env, KHONG commit .env.
DATABASE_URL="postgresql://portal:portal@localhost:5435/hoahuy_portal?schema=public"
APP_URL="http://localhost:3200"

# CRM Hoa Huy: dia chi goc va bi mat HMAC dung chung (khop SUPPLIER_PORTAL_HMAC_SECRET o CRM). Chi goi tu may chu cong.
CRM_BASE_URL="http://localhost:3145"
CRM_HMAC_SECRET="doi-thanh-chuoi-ngau-nhien-dai-64-ky-tu"

# Bi mat HMAC CRM dung khi goi admin-api cua cong (tao/khoa tai khoan). Khac CRM_HMAC_SECRET.
PORTAL_ADMIN_HMAC_SECRET="doi-thanh-chuoi-ngau-nhien-khac"

# Khoa ma hoa API Key tung NCC (AES-256-GCM): 64 ky tu hex = 32 byte. Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRED_ENC_KEY=""

# Bi mat bam thiet bi/OTP/token (HMAC), 32+ ky tu ngau nhien.
TOKEN_PEPPER=""

# Email (SMTP cong ty). Bo trong SMTP_HOST = ghi thu ra console (chi dung khi phat trien).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Hoa Huy <no-reply@hoahuy.com>"

# Quet virus (ClamAV clamd). Bo trong = bo qua buoc quet (chi dung khi phat trien).
CLAMD_HOST=""
CLAMD_PORT="3310"
